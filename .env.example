# RAIS Growth Engine - Backend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Google Business Profile API OAuth 2.0 Credentials
USE_MOCK_GBP=False
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Security & Secret Keys
SECRET_KEY=rais-local-growth-engine-secret-key-change-in-production
TOKEN_ENCRYPTION_KEY=4f8a92b1c3d5e7f0123456789abcdef0123456789abcdef0123456789abcdef0

# LLM Engine (template_engine, gemini, ollama, openai)
LLM_PROVIDER=template_engine
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./rais_growth_engine.db
